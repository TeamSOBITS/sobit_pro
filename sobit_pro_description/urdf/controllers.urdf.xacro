<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_pro_controllers" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="controllers" params="name enable_gz:=False enable_mb:=True enable_arm:=True enable_head:=True robot_name:=sobit_pro">

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${$(arg enable_gz)}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${$(arg enable_gz)}">
          <plugin>dynamixel_hardware/DynamixelHardware</plugin>
          <param name="port_name">/dev/ttyUSB0</param>
          <param name="baud_rate">1000000</param>
          <!-- <param name="protocol_version">2.0</param> -->
          <!-- <param name="use_dummy">true</param> -->
        </xacro:unless>
      </hardware>

       <!-- Position Drive - Arm -->
      <xacro:if value="${$(arg enable_arm)}">
        <joint name="arm_shoulder_1_tilt_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">11</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">1.57</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="arm_shoulder_2_tilt_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">12</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">-1.57</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="arm_elbow_upper_1_tilt_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">13</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">1.57</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="arm_elbow_upper_2_tilt_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">14</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">-1.57</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="arm_elbow_lower_tilt_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">15</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">-1.57</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="arm_elbow_lower_pan_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">16</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="arm_wrist_tilt_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">17</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">-1.57</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <!-- Position Drive: Hand -->
        <joint name="hand_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">18</param>
            <param name="control_mode">6</param>
            <param name="Goal_Current">150</param>
            <param name="interface">rs</param>
            <param name="gear_ratio">1.0</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">0.0</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
        <!-- Passive mimic finger joints (gz only): dartsim cannot create
             mimic constraints from the SDF, so without this the fingers are
             completely uncontrolled and sag open under gravity. Registering
             them state-only lets gz_ros2_control detect the URDF <mimic>
             tag (multiplier/offset included) and enforce the coupling
             itself. The real robot has a physical linkage, so this section
             must stay gz-only. Command interfaces are intentionally absent:
             ros2_control rejects mimic joints that declare them. -->
        <xacro:if value="${$(arg enable_gz)}">
          <joint name="hand_inner_l_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
          <joint name="hand_outer_l_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
          <joint name="hand_outer_r_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
          <joint name="hand_finger_l_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
          <joint name="hand_finger_r_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </joint>
        </xacro:if>
      </xacro:if>

      <!-- Position Drive: Head -->
      <xacro:if value="${$(arg enable_head)}">
        <joint name="head_pan_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">21</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="head_tilt_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">22</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>
      </xacro:if>

      <!-- Position Drive: Wheels -->
      <xacro:if value="${$(arg enable_mb)}">
        <joint name="wheel_f_r_steer_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">5</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="wheel_f_l_steer_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">6</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="wheel_b_r_steer_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">7</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="wheel_b_l_steer_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">8</param>
            <param name="control_mode">0</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="position">
            <param name="min">-1.570796327</param>
            <param name="max">1.570796327</param>
          </command_interface>
          <!-- <command_interface name="velocity"/> -->
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>  
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
        </joint>

        <joint name="wheel_f_r_drive_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">1</param>
            <param name="control_mode">1</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <joint name="wheel_f_l_drive_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">2</param>
            <param name="control_mode">1</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <joint name="wheel_b_r_drive_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">3</param>
            <param name="control_mode">1</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>

        <joint name="wheel_b_l_drive_joint">
          <xacro:unless value="${$(arg enable_gz)}">
            <param name="id">4</param>
            <param name="control_mode">1</param>
            <param name="interface">rs</param>
            <param name="Return_Delay_Time">0</param>
          </xacro:unless>
          <command_interface name="velocity"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </xacro:if>

    </ros2_control>


    <!-- Gazebo Sim ROS2 Control -->
    <xacro:if value="${$(arg enable_gz)}">
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <ros>
            <namespace>$(arg robot_name)</namespace>
          </ros>
          <parameters>$(find sobit_pro_control)/config/controllers_gz.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>
