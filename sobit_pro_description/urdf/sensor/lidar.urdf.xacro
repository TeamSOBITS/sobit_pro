<?xml version="1.0" encoding="UTF-8" ?>
<robot name="sobit_pro"
       xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="lidar_edge" params="prefix parent robot_name">

    <joint name="${prefix}_base_joint" type="fixed">
      <parent link="${parent}" />
      <child link="${prefix}_base_link" />
      <origin xyz="0.1500 0.0 0.0" rpy="0.0 0.0 0.0" />
    </joint>

    <link name="${prefix}_base_link">
      <visual>
        <origin xyz="0.0 0.0 0.0" rpy="${M_PI/2} 0.0 ${M_PI}" />
        <geometry>
          <mesh filename="file://$(find sobit_pro_description)/meshes/sensor/lidar_base.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <origin xyz="${0.092/2} 0.0 -${0.007/2}" rpy="0.0 0.0 0.0" />
        <geometry>
          <box size="0.092 0.184 0.007"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="${0.092/2} 0.0 -${0.007/2}" rpy="0.0 0.0 0.0" />
        <mass value="0.08" />
        <inertia ixx="${1/12*0.08*(0.092**2+0.007**2)}" ixy="0.0" ixz="0.0"
                 iyy="${1/12*0.08*(0.184**2+0.007**2)}" iyz="0.0"
                 izz="${1/12*0.08*(0.092**2+0.184**2)}" />
      </inertial>
    </link>


    <xacro:hokuyo_ust_mount prefix="${prefix}" parent="${prefix}_base_link" topic="${prefix}/scan" robot_name="${robot_name}" >
      <origin xyz="0.067 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:hokuyo_ust_mount>

  </xacro:macro>

  <xacro:macro name="lidar" params="parent prefix robot_name">
  
    <xacro:lidar_edge prefix="${prefix}" parent="${parent}" robot_name="${robot_name}"/>

  </xacro:macro>
</robot>
