<?xml version="1.0" ?>
<robot name="sensor_asus_xtion_pro" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Include external macros -->
  <!-- <xacro:include filename="$(find turtlebot2_description)/urdf/turtlebot_gazebo.urdf.xacro"/>
  <xacro:include filename="$(find turtlebot2_description)/urdf/turtlebot_properties.urdf.xacro"/> -->

  <!-- Xacro properties -->
  <xacro:property name="asus_xtion_pro_cam_py" value="0.0205"/>
  <xacro:property name="asus_xtion_pro_depth_rel_rgb_py" value="0.0270"/>
  <xacro:property name="asus_xtion_pro_cam_rel_rgb_py" value="-0.0235"/>

  <!-- Macro Definition -->
  <xacro:macro name="sensor_asus_xtion_pro" params="prefix parent">

    <joint name="${prefix}_rgb_joint" type="fixed">
      <!-- <origin xyz="0.01088 0.02 0.0220" rpy="0.0 0.0 0.0"/> -->
      <!-- <origin xyz="0.009 0.0 0.012" rpy="0.0 0.0 0.0"/> -->
      <!-- <origin xyz="0.0265 0.023 0.012" rpy="${-M_PI/2.0} 0.0 ${-M_PI/2.0}"/> -->
      <origin xyz="0.029 0.023 0.015" rpy="${-M_PI/2.0} 0.0 ${-M_PI/2.0}"/>
      <!-- <origin xyz="0.0265 0.023 0.012" rpy="0.0 0.0 ${M_PI/2.0}"/> -->
      <parent link="${parent}"/>
      <child link="${prefix}_rgb_link"/>
    </joint>

    <link name="${prefix}_rgb_link"/>

    <joint name="${prefix}_rgb_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0.0 0 0.0"/>
      <parent link="${prefix}_rgb_link"/>
      <child link="${prefix}_rgb_optical_frame"/>
    </joint>

    <link name="${prefix}_rgb_optical_frame"/>

    <joint name="${prefix}_head_camera_joint" type="fixed">
      <!-- <origin xyz="0 ${asus_xtion_pro_cam_rel_rgb_py} 0" rpy="0.0 0.0 0.0"/> -->
      <origin xyz="${-asus_xtion_pro_cam_rel_rgb_py} 0 -0.019" rpy="0.0 0.0 0.0"/>
      <!-- <parent link="${parent}"/> -->
      <parent link="${prefix}_rgb_optical_frame"/>
      <child link="${prefix}_link"/>
    </joint>

    <link name="${prefix}_link">
      <visual>
        <!-- <origin xyz="-0.015 0.0035 0.004" rpy="0 0 0"/> -->
        <!-- <origin xyz="0.019 0.018 -0.017 " rpy="${M_PI/2.0} ${-M_PI/2.0} 0"/> -->
        <origin xyz="-0.005 -0.003 0.0013" rpy="${M_PI/2.0} ${-M_PI/2.0} 0"/>
        <!-- <origin xyz="0.0025 0.0265 0.004" rpy="0 0 0"/> -->
        <geometry>
          <mesh filename="file://$(find sobit_pro_description)/meshes/sensor/xtion/xtion_pro_camera.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
        <geometry>
          <box size="0.0730 0.2760 0.0720"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.170"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001152600" ixy="0.0" ixz="0.0"
                 iyy="0.000148934" iyz="0.0" izz="0.001154654"/>
      </inertial>
    </link>

    <joint name="${prefix}_depth_joint" type="fixed">
      <!-- <origin xyz="0 ${asus_xtion_pro_depth_rel_rgb_py} 0" rpy="0 0 0"/> -->
      <origin xyz="${-asus_xtion_pro_depth_rel_rgb_py} 0 0" rpy="0 0 0"/>
      <parent link="${prefix}_rgb_link"/>
      <child link="${prefix}_depth_link"/>
    </joint>

    <link name="${prefix}_depth_link"/>

    <joint name="${prefix}_depth_optical_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0.0 0 0.0"/>
      <parent link="${prefix}_depth_link"/>
      <child link="${prefix}_depth_optical_frame"/>
    </joint>

    <link name="${prefix}_depth_optical_frame"/>

  </xacro:macro>
</robot>
