<?xml version="1.0" ?>
<robot name="sobit_pro"
       xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="head_transmission" params="prefix">

    <xacro:SimpleTransmissionPosition joint="${prefix}_pan_joint"  reduction="1" />
    <xacro:SimpleTransmissionPosition joint="${prefix}_tilt_joint" reduction="1" />

  </xacro:macro>
</robot>
