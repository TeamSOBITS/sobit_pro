<?xml version="1.0" encoding="UTF-8" ?>
<!-- SOBIT PRO (Gazebo) -->
<robot name="sobit_pro_gazebo" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="gazebo_sensors" params="robot_name enable_gz_head_cam_color:=True enable_gz_head_cam_depth:=True enable_gz_lidar:=True">

    <!-- Sensor - Head Camera (Color) -->
    <xacro:if value="${enable_gz_head_cam_color}">
      <gazebo reference="head_camera_link">
        <sensor name="head_camera_color" type="camera">
          <pose>0.0 0.0 ${0.0175/2} ${M_PI/2} -${M_PI/2} 0.0</pose>
          
          <ignition_frame_id>${robot_name}/head_camera_link</ignition_frame_id>
          <topic>${robot_name}/head_camera/rgb/image_raw</topic>

          <always_on>1</always_on>
          <visualize>true</visualize>
          <update_rate>1</update_rate>

          <camera name="head_camera_color">
            <horizontal_fov>1.21126</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>RGB_INT8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- Sensor - Head Camera (Depth) -->
    <xacro:if value="${enable_gz_head_cam_depth}">
      <gazebo reference="head_camera_link">
        <sensor name="head_camera_depth" type="depth">
          <pose>0.0 0.0 ${0.0175/2} ${M_PI/2} -${M_PI/2} 0.0</pose>

          <ignition_frame_id>${robot_name}/head_camera_link</ignition_frame_id>
          <topic>${robot_name}/head_camera/depth_registered/image_raw</topic>

          <always_on>1</always_on>
          <visualize>true</visualize>
          <update_rate>1</update_rate>

          <camera name="head_camera_depth">
            <horizontal_fov>1.48702</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
          </camera>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- Sensor - LiDAR -->
    <xacro:if value="${enable_gz_lidar}">
      <gazebo reference="lidar_laser">
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0 0 0 0</pose>

          <ignition_frame_id>${robot_name}/lidar_laser</ignition_frame_id>
          <!-- <qos>
            <topic name=${robot_name}/scan>
              <publisher>
                <reliability>best_effort</reliability>
                <durability>volatile</durability>
                <history>keep_last</history>
                <depth>5</depth>
              </publisher>
            </topic>
          </qos> -->
          <topic>${robot_name}/scan</topic>

          <always_on>1</always_on>
          <visualize>true</visualize>
          <update_rate>10</update_rate>

          <ray>
            <scan>
              <horizontal>
                <samples>640</samples>
                <resolution>1</resolution>
                <!-- <min_angle>-2.4870942</min_angle>
                <max_angle>2.4870942</max_angle> -->
                <min_angle>-1.5708</min_angle>
                <max_angle>1.5708</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>0.01</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.10000000149011612</min>
              <max>10.0</max>
              <resolution>0.01</resolution>
            </range>
          </ray>
        </sensor>
      </gazebo>
    </xacro:if>

    <!-- Publish Joint States -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>${robot_name}/joint_states</topic>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>
